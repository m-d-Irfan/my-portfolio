# The environment contract. Copy to .env.example and COMMIT it.
# Then copy to .env, fill in real values, and never commit that.
#
# This file is two things at once:
#   1. The onboarding doc — everything a new machine needs.
#   2. The rotation checklist after a leak. A key missing here is a key nobody
#      remembers to rotate.
#
# Every key listed here must be read through env() in settings.py, and every
# key read through env() must appear here. CI checks both directions —
# see references/01-env-contract.md.

# =============================================================================
# Core
# =============================================================================

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Never reuse across environments. Rotating logs every user out unless
# SECRET_KEY_FALLBACKS is used — see security-hardening/04-secrets.md.
SECRET_KEY=

# S4: this was hardcoded True in settings.py, which cascaded to
# SECURE_SSL_REDIRECT, SESSION_COOKIE_SECURE and CSRF_COOKIE_SECURE all being
# off in production, because each was defined as `not DEBUG`.
# Read with env_bool — bool('False') is True.
DEBUG=False

# Comma-separated. Django rejects any Host header not on this list, which is
# what stops host-header poisoning. Never use '*' in production.
ALLOWED_HOSTS=localhost,127.0.0.1

# True when a reverse proxy (nginx, Cloudflare) terminates TLS, so Django
# trusts X-Forwarded-Proto. Setting this without a proxy in front lets a client
# claim HTTPS by sending the header.
BEHIND_TLS_PROXY=False

# =============================================================================
# Database — MySQL in production, SQLite locally
# =============================================================================
DB_ENGINE=django.db.backends.mysql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Seconds a connection is reused. 0 opens a new connection per request (slow);
# 60 is a reasonable default. Note that after a password rotation, workers
# holding a live connection keep working until it recycles — always verify
# from a fresh process.
DB_CONN_MAX_AGE=60

# =============================================================================
# Email — Gmail App Password, NOT the account password. Requires 2FA.
# =============================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Where the outbox drainer gives up and dead-letters. See jobs-and-integrations.
EMAIL_MAX_RETRIES=5

# =============================================================================
# Cache — REQUIRED for throttling to work across gunicorn workers.
# =============================================================================
# N2: with LocMemCache, each worker keeps its own counters, so four workers
# give an attacker four times the rate limit and a restart resets everything.
REDIS_URL=redis://127.0.0.1:6379/1

# =============================================================================
# Media — Cloudinary
# =============================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =============================================================================
# Steadfast courier
# =============================================================================
# C1: these were read as os.environ.get('<the literal key>') — the secret was
# pasted in as the variable NAME. No such variable existed, so both were None,
# and courier dispatch and tracking were silently dead in production.
# Sandbox and live credentials are separate. Confirm which pair you are setting.
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_TIMEOUT_SECONDS=10

# =============================================================================
# bKash — SERVER SIDE ONLY. Never expose any of these to the browser.
# =============================================================================
# The browser may receive a checkout script URL and a short-lived, server-issued
# payment token. Nothing here can ever reach the React bundle.
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# Kept on SANDBOX in this example deliberately. A copy-paste that hits live
# payments is a bad first day.
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_TIMEOUT_SECONDS=15

# =============================================================================
# URLs — no trailing slash. Consumers join with a leading slash.
# =============================================================================
FRONTEND_URL=https://www.delhialuminium.com
BACKEND_URL=https://api.delhialuminium.com

# Comma-separated. Must include the scheme.
CORS_ALLOWED_ORIGINS=https://www.delhialuminium.com
CSRF_TRUSTED_ORIGINS=https://www.delhialuminium.com,https://api.delhialuminium.com

# =============================================================================
# Auth
# =============================================================================
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# OTP: hashed, expiring, attempt-capped. See auth-flows/03-otp.md.
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# =============================================================================
# Observability
# =============================================================================
LOG_LEVEL=INFO

# Optional. Leave blank to disable error reporting entirely.
SENTRY_DSN=
ENVIRONMENT=production

# =============================================================================
# Frontend (a SEPARATE .env in the React project)
# =============================================================================
# Vite inlines every VITE_-prefixed variable into the bundle at build time.
# These are PUBLISHED SOURCE, not configuration. Verify after any change:
#   npm run build && grep -rn "VITE_" dist/assets/*.js
#
#   VITE_API_URL=https://api.delhialuminium.com
#
# Nothing secret goes here. Not the bKash secret, not the Cloudinary secret,
# not a database credential — the prefix is not a security boundary.
