# ---------------------------------------------------------------------------
# Environment contract.
#
# Copy to `.env` and fill in real values. This file IS tracked in git; `.env`
# must NEVER be. Every variable the application reads appears here — if you add
# an `env(...)` call in settings.py, add the key here in the same commit.
#
# Two rules that come from a real incident (audit ref: S3, C1):
#
#   1. A secret committed once is compromised forever. It lives in git history,
#      in every clone and every fork. Deleting it from HEAD is cleanup, not a
#      fix — rotate the credential.
#
#   2. Reference variables by NAME, never by value. Passing the key's value as
#      the variable name returns None silently, and the feature is dead with no
#      error for as long as nobody checks.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# Local development only. Never True on a deployed host.
DEBUG=True
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---------------------------------------------------------------
# sqlite | mysql | postgresql
DB_ENGINE=sqlite
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_CONN_MAX_AGE=60

# --- CORS / CSRF ------------------------------------------------------------
# Exact origins, comma separated, scheme included, no trailing slash.
# Never use a wildcard: it cannot be combined with credentials.
CORS_ORIGINS=http://localhost:5173

# --- TLS --------------------------------------------------------------------
# True when a proxy (nginx, Apache, cPanel) terminates TLS in front of Django.
# Only set this when the proxy always overwrites X-Forwarded-Proto — if a client
# can send it, SECURE_SSL_REDIRECT becomes bypassable.
BEHIND_TLS_PROXY=False
# Start at 3600 for a day, confirm nothing breaks, then raise to 31536000.
SECURE_HSTS_SECONDS=0
# Effectively irreversible for months. Do not enable until HTTPS is confirmed
# working on every subdomain.
SECURE_HSTS_PRELOAD=False

# --- JWT --------------------------------------------------------------------
# Short. This is the window a demoted admin keeps their old claims.
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- Auth -------------------------------------------------------------------
# mandatory | optional | none
ACCOUNT_EMAIL_VERIFICATION=mandatory
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Locale -----------------------------------------------------------------
TIME_ZONE=Asia/Dhaka

# --- Email ------------------------------------------------------------------
# Gmail requires an App Password, not the account password. Rotate it if it has
# ever been committed.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- Cache ------------------------------------------------------------------
# Required in production. Throttle counters live here; LocMemCache is
# per-process, so behind 4 gunicorn workers an attacker gets 4x the rate and a
# restart clears every counter.
REDIS_URL=

# --- Courier: Steadfast -----------------------------------------------------
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1

# --- Payments: bKash --------------------------------------------------------
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=True

# --- Media: Cloudinary ------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
